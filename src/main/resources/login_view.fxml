<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="420.0" prefWidth="380.0"
            style="-fx-background-color: #f4f6f8;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fedeiatech.sistemagestionpyme.view.LoginController">
    <children>
        <VBox alignment="CENTER" spacing="0.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <VBox alignment="CENTER" spacing="6.0"
                      style="-fx-background-color: #2c3e50; -fx-padding: 30 40 30 40;">
                    <children>
                        <Label text="JFX Business Engine" textFill="WHITE">
                            <font><Font name="System Bold" size="22.0" /></font>
                        </Label>
                        <Label text="Sistema de Gestión PyME" textFill="#95a5a6">
                            <font><Font size="12.0" /></font>
                        </Label>
                    </children>
                </VBox>

                <VBox alignment="CENTER" spacing="14.0"
                      style="-fx-background-color: white; -fx-padding: 35 40 35 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 3);">
                    <children>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Usuario" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" />
                                <TextField fx:id="txtUsuario" promptText="Nombre de usuario"
                                           onAction="#iniciarSesion"
                                           style="-fx-padding: 8; -fx-border-color: #dde1e7; -fx-border-radius: 4; -fx-background-radius: 4;" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Contraseña" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" />
                                <PasswordField fx:id="txtPassword" promptText="Contraseña"
                                              onAction="#iniciarSesion"
                                              style="-fx-padding: 8; -fx-border-color: #dde1e7; -fx-border-radius: 4; -fx-background-radius: 4;" />
                            </children>
                        </VBox>

                        <Label fx:id="lblError" text="" textFill="#e74c3c"
                               style="-fx-font-size: 11;" wrapText="true" />

                        <Button fx:id="btnIngresar" text="INGRESAR" onAction="#iniciarSesion"
                                maxWidth="Infinity"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand; -fx-background-radius: 4;" />

                    </children>
                </VBox>

                <Label text="~by FedeiaTech · v0.9.0" textFill="#bdc3c7" style="-fx-font-size: 10; -fx-padding: 12 0 0 0;" />

            </children>
        </VBox>
    </children>
</AnchorPane>
