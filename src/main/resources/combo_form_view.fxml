<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="560.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fedeiatech.sistemagestionpyme.view.ComboFormController">
    <children>
        <VBox spacing="12.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>

                <Label text="Datos del Combo" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #8e44ad;" />

                <HBox spacing="10.0">
                    <children>
                        <VBox spacing="4.0">
                            <Label text="Código" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" />
                            <TextField fx:id="txtCodigo" promptText="Ej: COMBO01" prefWidth="110.0" />
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label text="Nombre" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" />
                            <TextField fx:id="txtNombre" promptText="Nombre del combo" />
                        </VBox>
                        <VBox spacing="4.0">
                            <Label text="Precio de Venta ($)" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" />
                            <TextField fx:id="txtPrecio" promptText="0.00" prefWidth="110.0" />
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="4.0">
                    <Label text="Descripción (opcional)" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" />
                    <TextField fx:id="txtDescripcion" promptText="Descripción del combo" />
                </VBox>

                <Label text="Componentes" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #2c3e50;" />

                <HBox spacing="8.0">
                    <children>
                        <TextField fx:id="txtBuscarItem" promptText="Buscar producto por código o nombre..."
                                   HBox.hgrow="ALWAYS" onAction="#agregarComponente" />
                        <TextField fx:id="txtCantComp" promptText="Cant." prefWidth="70.0" />
                        <Button text="+ Agregar" onAction="#agregarComponente"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;" />
                    </children>
                </HBox>

                <TableView fx:id="tablaComponentes" VBox.vgrow="ALWAYS" prefHeight="160.0">
                    <columns>
                        <TableColumn fx:id="colCompCodigo" text="Código" prefWidth="90.0" />
                        <TableColumn fx:id="colCompNombre" text="Producto" prefWidth="230.0" />
                        <TableColumn fx:id="colCompCantidad" text="Cantidad" prefWidth="80.0" />
                        <TableColumn fx:id="colCompAccion" text="" prefWidth="80.0" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Label fx:id="lblStock" text="Stock calculado: —"
                       style="-fx-font-size: 13; -fx-text-fill: #27ae60; -fx-font-weight: bold;" />

                <HBox spacing="10.0" alignment="CENTER_RIGHT">
                    <children>
                        <Button fx:id="btnEliminar" text="ELIMINAR COMBO" onAction="#eliminarCombo"
                                visible="false" managed="false"
                                style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                        <Button text="CANCELAR" onAction="#cancelar"
                                style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                        <Button text="GUARDAR" onAction="#guardar"
                                style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
