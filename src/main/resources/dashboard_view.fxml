<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="730.0" prefWidth="960.0" style="-fx-background-color: #f4f6f8;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fedeiatech.sistemagestionpyme.view.DashboardController">
    <children>
        <VBox spacing="14.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <ImageView fitHeight="32.0" fitWidth="32.0" preserveRatio="true">
                            <image><Image url="@images/logo_ferrematica.png" /></image>
                        </ImageView>
                        <Label text="Panel de Control" textFill="#2c3e50">
                            <font><Font name="System Bold" size="26.0" /></font>
                        </Label>
                        <Label fx:id="lblEstadoFiscal"
                               style="-fx-background-color: #bdc3c7; -fx-text-fill: #7f8c8d; -fx-background-radius: 15; -fx-padding: 5 15;"
                               text="ARCA (sin configurar)">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <Label fx:id="lblEstadoSync"
                               style="-fx-background-color: #bdc3c7; -fx-text-fill: #7f8c8d; -fx-background-radius: 15; -fx-padding: 5 15;"
                               text="Sync (deshabilitado)">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnTema0" onAction="#cambiarTema" prefWidth="20.0" prefHeight="20.0"
                                style="-fx-background-color: #ffffff; -fx-background-radius: 50%; -fx-padding: 0; -fx-cursor: hand; -fx-border-color: #bdc3c7; -fx-border-radius: 50%; -fx-border-width: 1;" />
                        <Button fx:id="btnTema1" onAction="#cambiarTema" prefWidth="20.0" prefHeight="20.0"
                                style="-fx-background-color: #c9cfd4; -fx-background-radius: 50%; -fx-padding: 0; -fx-cursor: hand; -fx-border-color: #9a9c9d; -fx-border-radius: 50%; -fx-border-width: 1;" />
                        <Button fx:id="btnTema2" onAction="#cambiarTema" prefWidth="20.0" prefHeight="20.0"
                                style="-fx-background-color: #c9d3cd; -fx-background-radius: 50%; -fx-padding: 0; -fx-cursor: hand; -fx-border-color: #9a9c9d; -fx-border-radius: 50%; -fx-border-width: 1;" />
                        <Button fx:id="btnTema3" onAction="#cambiarTema" prefWidth="20.0" prefHeight="20.0"
                                style="-fx-background-color: #b3cad6; -fx-background-radius: 50%; -fx-padding: 0; -fx-cursor: hand; -fx-border-color: #9a9c9d; -fx-border-radius: 50%; -fx-border-width: 1;" />
                        <Button fx:id="btnTema4" onAction="#cambiarTema" prefWidth="20.0" prefHeight="20.0"
                                style="-fx-background-color: #cbafd4; -fx-background-radius: 50%; -fx-padding: 0; -fx-cursor: hand; -fx-border-color: #9a9c9d; -fx-border-radius: 50%; -fx-border-width: 1;" />
                        <Button fx:id="btnTema5" onAction="#cambiarTema" prefWidth="20.0" prefHeight="20.0"
                                style="-fx-background-color: #d6c9b3; -fx-background-radius: 50%; -fx-padding: 0; -fx-cursor: hand; -fx-border-color: #9a9c9d; -fx-border-radius: 50%; -fx-border-width: 1;" />
                        <Button fx:id="btnTema6" onAction="#cambiarTema" prefWidth="20.0" prefHeight="20.0"
                                style="-fx-background-color: #f0e4c4; -fx-background-radius: 50%; -fx-padding: 0; -fx-cursor: hand; -fx-border-color: #B24C37; -fx-border-radius: 50%; -fx-border-width: 2;" />
                        <Label fx:id="lblUsuario" textFill="#7f8c8d" style="-fx-font-size: 12;" />
                        <Button fx:id="btnUsuarios" text="👥 Usuarios" onAction="#abrirUsuarios"
                                style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-size: 11; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 5 12;" />
                        <Button text="Leeme" onAction="#abrirLeerMe"
                                style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 11; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 5 12;" />
                        <Button text="Acerca de" onAction="#abrirAcercaDe"
                                style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 11; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 5 12;" />
                        <Button text="Cerrar sesión" onAction="#cerrarSesion"
                                style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-size: 11; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 5 12;" />
                    </children>
                </HBox>

                <TabPane fx:id="tabPaneDashboard" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="Resumen" closable="false">
                            <content>
                                <VBox spacing="14.0" style="-fx-background-color: transparent;">
                                    <children>

                                        <HBox spacing="14.0">
                                            <children>

                                                <VBox spacing="6.0" HBox.hgrow="ALWAYS"
                                                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 18;">
                                                    <children>
                                                        <Label text="Ventas del Día" textFill="#7f8c8d">
                                                            <font><Font size="13.0" /></font>
                                                        </Label>
                                                        <Label fx:id="lblVentasDia" text="ARS 0.00" textFill="#27ae60">
                                                            <font><Font name="System Bold" size="34.0" /></font>
                                                        </Label>
                                                        <Label fx:id="lblContadorVentas" text="0 transacciones hoy" textFill="#95a5a6">
                                                            <font><Font size="12.0" /></font>
                                                        </Label>
                                                    </children>
                                                </VBox>

                                                <VBox spacing="6.0" HBox.hgrow="ALWAYS"
                                                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 18;">
                                                    <children>
                                                        <Label text="Ganancia Est. del Día" textFill="#7f8c8d">
                                                            <font><Font size="13.0" /></font>
                                                        </Label>
                                                        <Label fx:id="lblGananciaDia" text="ARS 0.00" textFill="#8e44ad">
                                                            <font><Font name="System Bold" size="34.0" /></font>
                                                        </Label>
                                                        <Label text="precio venta − costo" textFill="#95a5a6">
                                                            <font><Font size="12.0" /></font>
                                                        </Label>
                                                    </children>
                                                </VBox>

                                                <VBox spacing="6.0" HBox.hgrow="ALWAYS"
                                                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 18;">
                                                    <children>
                                                        <Label text="Items Stock Crítico" textFill="#7f8c8d">
                                                            <font><Font size="13.0" /></font>
                                                        </Label>
                                                        <Label fx:id="lblStockCritico" text="0" textFill="#27ae60">
                                                            <font><Font name="System Bold" size="34.0" /></font>
                                                        </Label>
                                                        <Label text="con stock ≤ 5 unidades" textFill="#95a5a6">
                                                            <font><Font size="12.0" /></font>
                                                        </Label>
                                                    </children>
                                                </VBox>

                                            </children>
                                        </HBox>

                                        <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                                            <children>

                                                <VBox spacing="8.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
                                                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 15;">
                                                    <children>
                                                        <Label text="Ventas Últimos 7 Días" textFill="#7f8c8d">
                                                            <font><Font size="13.0" /></font>
                                                        </Label>
                                                        <BarChart fx:id="chartVentas7Dias" animated="false" legendVisible="false"
                                                                  VBox.vgrow="ALWAYS">
                                                            <xAxis><CategoryAxis /></xAxis>
                                                            <yAxis><NumberAxis /></yAxis>
                                                        </BarChart>
                                                    </children>
                                                </VBox>

                                                <VBox spacing="8.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
                                                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 15;">
                                                    <children>
                                                        <Label text="Top 5 Más Vendidos (histórico, por unidades)" textFill="#7f8c8d">
                                                            <font><Font size="13.0" /></font>
                                                        </Label>
                                                        <PieChart fx:id="chartTop5" animated="false" labelsVisible="true"
                                                                  VBox.vgrow="ALWAYS" />
                                                    </children>
                                                </VBox>

                                            </children>
                                        </HBox>

                                    </children>
                                </VBox>
                            </content>
                        </Tab>
                        <Tab fx:id="tabBalances" text="Balances" closable="false">
                            <content>
                                <fx:include source="/balances_view.fxml" fx:id="balances" />
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>

                <HBox spacing="14.0">
                    <children>
                        <Button fx:id="btnPOS" mnemonicParsing="false" onAction="#abrirPOS"
                                prefHeight="60.0" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15; -fx-background-radius: 10; -fx-cursor: hand;"
                                text="Nueva Venta (POS) 🛒" />
                        <Button fx:id="btnInventario" mnemonicParsing="false" onAction="#abrirInventario"
                                prefHeight="60.0" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: white; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2); -fx-cursor: hand;"
                                text="Inventario 📦" />
                        <Button fx:id="btnCompras" mnemonicParsing="false" onAction="#abrirCompras"
                                prefHeight="60.0" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: white; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2); -fx-cursor: hand;"
                                text="Compras 🧾" />
                        <Button fx:id="btnConfiguracion" mnemonicParsing="false" onAction="#abrirConfiguracion"
                                prefHeight="60.0" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: white; -fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-font-size: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2); -fx-cursor: hand;"
                                text="Configuración" />
                        <Button fx:id="btnReportes" mnemonicParsing="false" onAction="#abrirReportes"
                                prefHeight="60.0" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15; -fx-background-radius: 10; -fx-cursor: hand;"
                                text="Reportes 📈" />
                        <Button fx:id="btnEstadisticas" mnemonicParsing="false" onAction="#abrirEstadisticasDashboard"
                                prefHeight="60.0" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: #1abc9c; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15; -fx-background-radius: 10; -fx-cursor: hand;"
                                text="Estadísticas 📊" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
