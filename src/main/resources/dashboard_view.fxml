<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="730.0" prefWidth="960.0" style="-fx-background-color: #f4f6f8;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fedeiatech.sistemagestionpyme.view.DashboardController">
    <children>
        <VBox spacing="14.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label text="Panel de Control" textFill="#2c3e50">
                            <font><Font name="System Bold" size="26.0" /></font>
                        </Label>
                        <Label fx:id="lblEstadoFiscal"
                               style="-fx-background-color: #eec528; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 5 15;"
                               text="Verificando...">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblUsuario" textFill="#7f8c8d" style="-fx-font-size: 12;" />
                        <Button fx:id="btnUsuarios" text="👥 Usuarios" onAction="#abrirUsuarios"
                                style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-size: 11; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 5 12;" />
                        <Button text="Cerrar sesión" onAction="#cerrarSesion"
                                style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-size: 11; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 5 12;" />
                    </children>
                </HBox>

                <HBox spacing="14.0">
                    <children>

                        <VBox spacing="6.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 18;">
                            <children>
                                <Label text="Ventas del Día" textFill="#7f8c8d">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Label fx:id="lblVentasDia" text="ARS 0.00" textFill="#27ae60">
                                    <font><Font name="System Bold" size="34.0" /></font>
                                </Label>
                                <Label fx:id="lblContadorVentas" text="0 transacciones hoy" textFill="#95a5a6">
                                    <font><Font size="12.0" /></font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox spacing="6.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 18;">
                            <children>
                                <Label text="Ganancia Est. del Día" textFill="#7f8c8d">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Label fx:id="lblGananciaDia" text="ARS 0.00" textFill="#8e44ad">
                                    <font><Font name="System Bold" size="34.0" /></font>
                                </Label>
                                <Label text="precio venta − costo" textFill="#95a5a6">
                                    <font><Font size="12.0" /></font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox spacing="6.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 18;">
                            <children>
                                <Label text="Items Stock Crítico" textFill="#7f8c8d">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Label fx:id="lblStockCritico" text="0" textFill="#27ae60">
                                    <font><Font name="System Bold" size="34.0" /></font>
                                </Label>
                                <Label text="con stock ≤ 5 unidades" textFill="#95a5a6">
                                    <font><Font size="12.0" /></font>
                                </Label>
                            </children>
                        </VBox>

                    </children>
                </HBox>

                <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                    <children>

                        <VBox spacing="8.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 15;">
                            <children>
                                <Label text="Ventas Últimos 7 Días" textFill="#7f8c8d">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <BarChart fx:id="chartVentas7Dias" animated="false" legendVisible="false"
                                          VBox.vgrow="ALWAYS">
                                    <xAxis><CategoryAxis /></xAxis>
                                    <yAxis><NumberAxis /></yAxis>
                                </BarChart>
                            </children>
                        </VBox>

                        <VBox spacing="8.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 15;">
                            <children>
                                <Label text="Top 5 Productos Más Vendidos" textFill="#7f8c8d">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <PieChart fx:id="chartTop5" animated="false" labelsVisible="true"
                                          VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>

                    </children>
                </HBox>

                <HBox spacing="14.0">
                    <children>
                        <Button fx:id="btnPOS" mnemonicParsing="false" onAction="#abrirPOS"
                                prefHeight="60.0" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15; -fx-background-radius: 10; -fx-cursor: hand;"
                                text="Nueva Venta (POS) 🛒" />
                        <Button fx:id="btnInventario" mnemonicParsing="false" onAction="#abrirInventario"
                                prefHeight="60.0" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: white; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2); -fx-cursor: hand;"
                                text="Inventario 📦" />
                        <Button fx:id="btnConfiguracion" mnemonicParsing="false" onAction="#abrirConfiguracion"
                                prefHeight="60.0" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: white; -fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-font-size: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2); -fx-cursor: hand;"
                                text="Configuración ⚙️" />
                        <Button fx:id="btnReportes" mnemonicParsing="false" onAction="#abrirReportes"
                                prefHeight="60.0" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15; -fx-background-radius: 10; -fx-cursor: hand;"
                                text="Reportes 📈" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
