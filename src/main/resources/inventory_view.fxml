<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fedeiatech.sistemagestionpyme.view.InventoryController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <children>
                <Label text="Gestión de Inventario" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <TableView fx:id="tablaItems" VBox.vgrow="ALWAYS" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre / Descripción" />
                        <TableColumn fx:id="colPrecio" prefWidth="120.0" text="Precio Venta" />
                        <TableColumn fx:id="colStock" prefWidth="100.0" text="Stock" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Label text="Nuevo Producto / Servicio:" textFill="#7f8c8d">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
            
                <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: #ecf0f1; -fx-padding: 10; -fx-background-radius: 5;">
                    <children>
                        <TextField fx:id="txtCodigo" promptText="Cód (ej. A01)" prefWidth="100.0" />
                        <TextField fx:id="txtNombre" promptText="Nombre del producto" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtPrecio" promptText="Precio $" prefWidth="100.0" />
                        <TextField fx:id="txtStock" promptText="Stock" prefWidth="80.0" />
                        <CheckBox fx:id="chkServicio" text="Es Servicio" />
                        <Button mnemonicParsing="false" onAction="#guardarItem" text="AGREGAR" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" />
                        <Button mnemonicParsing="false" onAction="#eliminarItem" text="ELIMINAR" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>