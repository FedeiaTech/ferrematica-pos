<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" id="AnchorPane" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f4f6f8;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fedeiatech.sistemagestionpyme.view.ReportsController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <VBox style="-fx-background-color: #8e44ad; -fx-padding: 20; -fx-background-radius: 10;">
               <children>
                  <Label text="Reportes y Métricas" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label text="Historial completo de transacciones" textFill="#e1bee7" />
               </children>
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Label fx:id="lblAvisoEnvios" managed="false" text="Estado de envío no disponible" textFill="#7f8c8d" visible="false">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#abrirEstadisticas" text="📈 Estadísticas ▸"
                          style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 18; -fx-cursor: hand; -fx-background-radius: 6;" />
                  <Button fx:id="btnExportar" onAction="#exportarExcel" text="📊 Exportar Excel"
                          style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 18; -fx-cursor: hand; -fx-background-radius: 6;" />
               </children>
            </HBox>

            <TableView fx:id="tablaVentas" VBox.vgrow="ALWAYS" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">
              <columns>
                <TableColumn fx:id="colId" prefWidth="75.0" text="ID Venta" />
                <TableColumn fx:id="colFecha" prefWidth="200.0" text="Fecha y Hora" />
                <TableColumn fx:id="colTotal" prefWidth="150.0" text="Total (ARS)" />
                <TableColumn fx:id="colEstado" prefWidth="110.0" text="Estado" />
                <TableColumn fx:id="colEstadoEnvio" prefWidth="140.0" text="Estado de envío" />
                <TableColumn fx:id="colHoraEntrega" prefWidth="130.0" text="Hora de entrega" />
                <TableColumn fx:id="colAccion" prefWidth="200.0" text="Acción" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>
