<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fedeiatech.sistemagestionpyme.view.MainController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <children>
                <Label text="Sistema FedeiaTech - Gestión de Inventario" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <TableView fx:id="tablaItems" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre / Descripción" />
                        <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio Venta" />
                        <TableColumn fx:id="colStock" prefWidth="80.0" text="Stock" />
                    </columns>
                </TableView>

                <Label text="Nuevo Producto / Servicio:" textFill="#7f8c8d">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
            
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <children>
                        <TextField fx:id="txtCodigo" promptText="Cód (ej. A01)" prefWidth="100.0" />
                        <TextField fx:id="txtNombre" promptText="Nombre del producto" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtPrecio" promptText="Precio $" prefWidth="100.0" />
                        <TextField fx:id="txtStock" promptText="Stock" prefWidth="80.0" />
                        <CheckBox fx:id="chkServicio" text="Es Servicio" />
                        <Button mnemonicParsing="false" onAction="#guardarItem" text="AGREGAR" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" />
                        <Button mnemonicParsing="false" onAction="#eliminarItem" text="ELIMINAR" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>