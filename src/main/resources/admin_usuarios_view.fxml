<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #f4f6f8;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fedeiatech.sistemagestionpyme.view.AdminUsuariosController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>

                <VBox style="-fx-background-color: #2c3e50; -fx-padding: 18 20; -fx-background-radius: 10;">
                    <children>
                        <Label text="Gestión de Usuarios" textFill="WHITE">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                        <Label text="Solo administradores" textFill="#95a5a6">
                            <font><Font size="11.0" /></font>
                        </Label>
                    </children>
                </VBox>

                <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS"
                           style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 5, 0, 0, 2);">
                    <columns>
                        <TableColumn fx:id="colNombre" text="Usuario" prefWidth="250.0" />
                        <TableColumn fx:id="colRol" text="Rol" prefWidth="150.0" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Label fx:id="lblFormTitulo" text="Nuevo usuario:" textFill="#7f8c8d">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Label>

                <HBox spacing="10.0" alignment="BOTTOM_LEFT"
                      style="-fx-background-color: #ecf0f1; -fx-padding: 12; -fx-background-radius: 5;">
                    <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Usuario" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" />
                                <TextField fx:id="txtNombre" promptText="Nombre de usuario" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Contraseña" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" />
                                <PasswordField fx:id="txtPassword" promptText="Contraseña" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="Rol" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" />
                                <ComboBox fx:id="cmbRol" prefWidth="120.0" />
                            </children>
                        </VBox>

                        <Button fx:id="btnGuardar" text="AGREGAR" onAction="#guardarUsuario"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                        <Button fx:id="btnCambiarPassword" text="CAMBIAR PASS" onAction="#cambiarPassword"
                                visible="false" managed="false"
                                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                        <Button fx:id="btnCancelar" text="CANCELAR" onAction="#cancelarEdicion"
                                visible="false" managed="false"
                                style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                        <Button text="ELIMINAR" onAction="#eliminarUsuario"
                                style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                    </children>
                </HBox>

                <Label fx:id="lblMensaje" text="" textFill="#e74c3c" style="-fx-font-size: 11;" />

            </children>
        </VBox>
    </children>
</AnchorPane>
