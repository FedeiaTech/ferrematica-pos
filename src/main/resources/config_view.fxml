<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="640.0" prefWidth="820.0" style="-fx-background-color: #f4f6f8;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fedeiatech.sistemagestionpyme.view.ConfigController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0"
            AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <Label text="Configuración del Sistema" textFill="#2c3e50">
               <font><Font name="System Bold" size="24.0" /></font>
            </Label>

            <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
                     style="-fx-background-color: white; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">
               <tabs>

                  <!-- ===== DATOS EMPRESA ===== -->
                  <Tab text="Datos Empresa">
                     <content>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                        <content><AnchorPane minHeight="300.0">
                           <children>
                              <GridPane hgap="15.0" vgap="15.0" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0">
                                 <columnConstraints>
                                    <ColumnConstraints minWidth="180.0" prefWidth="180.0" />
                                    <ColumnConstraints hgrow="ALWAYS" prefWidth="320.0" />
                                 </columnConstraints>
                                 <rowConstraints>
                                    <RowConstraints prefHeight="32.0" />
                                    <RowConstraints prefHeight="32.0" />
                                    <RowConstraints prefHeight="32.0" />
                                    <RowConstraints prefHeight="32.0" />
                                    <RowConstraints prefHeight="32.0" />
                                    <RowConstraints prefHeight="28.0" />
                                 </rowConstraints>
                                 <children>
                                    <Label text="Nombre Fantasía:" />
                                    <TextField fx:id="txtNombreEmpresa" GridPane.columnIndex="1" />
                                    <Label text="Doc. Tributario (CUIT):" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtCuit" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label text="Dirección:" GridPane.rowIndex="2" />
                                    <TextField fx:id="txtDireccion" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Label text="Condición IVA:" GridPane.rowIndex="3" />
                                    <TextField fx:id="txtCondicionIva" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    <Label text="Punto de Venta (AFIP):" GridPane.rowIndex="4" />
                                    <TextField fx:id="txtPuntoVenta" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                    <Label text="Número de punto de venta que te asignó AFIP para numerar comprobantes fiscales — no es el nombre del local ni la caja registradora."
                                           style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;" wrapText="true" maxWidth="320.0"
                                           GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                 </children>
                              </GridPane>
                           </children>
                        </AnchorPane></content>
                        </ScrollPane>
                     </content>
                  </Tab>

                  <!-- ===== PERSONALIZACIÓN ===== -->
                  <Tab text="Personalización">
                     <content>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                        <content><AnchorPane minHeight="500.0">
                           <children>
                              <VBox spacing="14.0" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="15.0" AnchorPane.rightAnchor="20.0">
                                 <children>

                                    <!-- Logo -->
                                    <Label text="Logotipo del Ticket" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                                    <HBox spacing="12.0" alignment="CENTER_LEFT">
                                       <ImageView fx:id="imgLogoPreview" fitHeight="70.0" fitWidth="70.0" preserveRatio="true"
                                                  style="-fx-effect: dropshadow(three-pass-box, gray, 4, 0, 0, 0);" />
                                       <VBox spacing="6.0">
                                          <Button text="Seleccionar imagen..." onAction="#seleccionarLogo" />
                                          <Label fx:id="lblRutaLogo" text="Sin imagen seleccionada" textFill="GRAY" wrapText="true" maxWidth="380.0" />
                                       </VBox>
                                    </HBox>

                                    <!-- Mensaje pie -->
                                    <Label text="Mensaje al pie del Ticket" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                                    <TextArea fx:id="txtMensajeTicket" prefHeight="60.0"
                                             promptText="Ej: Gracias por su compra. Seguinos en Instagram @local" />

                                    <Separator />

                                    <!-- Ancho ticket -->
                                    <Label text="Formato de Impresión" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                                       <Label text="Ancho de impresora térmica:" />
                                       <ChoiceBox fx:id="cmbAnchoTicket" prefWidth="100.0" />
                                       <Label text="(58mm y 80mm son los estándares más comunes)" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;" />
                                    </HBox>

                                    <!-- Datos en ticket -->
                                    <Label text="Datos visibles en el ticket" style="-fx-font-weight: bold;" />
                                    <HBox spacing="20.0">
                                       <CheckBox fx:id="chkMostrarDireccion" text="Mostrar Dirección" />
                                       <CheckBox fx:id="chkMostrarCuit" text="Mostrar CUIT" />
                                    </HBox>

                                    <!-- Decimales -->
                                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                                       <CheckBox fx:id="chkUsarEnteros" text="Redondear precios a enteros (sin centavos)" />
                                       <Label text="— recomendado para kioscos y locales de ropa" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;" />
                                    </HBox>

                                 </children>
                              </VBox>
                           </children>
                        </AnchorPane></content>
                        </ScrollPane>
                     </content>
                  </Tab>

                  <!-- ===== SISTEMA Y SEGURIDAD ===== -->
                  <Tab text="Sistema y Seguridad">
                     <content>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                        <content><AnchorPane minHeight="600.0">
                           <children>
                              <VBox spacing="14.0" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="15.0" AnchorPane.rightAnchor="20.0">
                                 <children>

                                    <!-- Reglas de negocio -->
                                    <Label text="Reglas de Negocio" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                                    <CheckBox fx:id="chkStockNegativo" text="Permitir ventas con Stock Negativo (recomendado para empezar)" />
                                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                                       <Label text="Recargo por pago con Tarjeta (%):" />
                                       <TextField fx:id="txtRecargo" prefWidth="60.0" text="0.0" />
                                    </HBox>

                                    <Separator />

                                    <!-- Tickets PDF -->
                                    <Label text="Almacenamiento de Tickets PDF" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                                    <Label text="Los datos de ventas se guardan siempre en la base de datos. Los PDFs son solo para impresión — si no hay carpeta configurada, son temporales."
                                           style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;" wrapText="true" />
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <TextField fx:id="txtRutaTickets" promptText="Sin configurar → tickets temporales" HBox.hgrow="ALWAYS" editable="false" />
                                       <Button text="Seleccionar carpeta" onAction="#seleccionarCarpetaTickets" />
                                       <Button text="Limpiar" onAction="#borrarRutaTickets"
                                               style="-fx-background-color: #7f8c8d; -fx-text-fill: white;" />
                                       <Button text="Abrir carpeta" onAction="#abrirCarpetaTickets" />
                                    </HBox>
                                    <Label fx:id="lblInfoTickets" text="" wrapText="true" maxWidth="700.0" />
                                    <HBox spacing="8.0">
                                       <Button text="Vaciar tickets de esta carpeta" onAction="#vaciarTicketsTemporales"
                                               style="-fx-background-color: #e67e22; -fx-text-fill: white;" />
                                       <Button text="Eliminar temporales de +30 días" onAction="#limpiarTemporalesAntiguos"
                                               style="-fx-background-color: #7f8c8d; -fx-text-fill: white;" />
                                    </HBox>

                                    <Separator />

                                    <!-- Base de datos -->
                                    <Label text="Base de Datos" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                                    <Label text="Todos los datos de ventas, productos y configuración se almacenan en el archivo gestion_pyme.db en la carpeta del programa."
                                           style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;" wrapText="true" />
                                    <HBox spacing="8.0">
                                       <Button text="Abrir carpeta de la base de datos" onAction="#abrirCarpetaDB" />
                                    </HBox>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <Button text="Borrar todas las ventas" onAction="#borrarTodasLasVentas"
                                               style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;" />
                                       <Label text="Elimina el historial de ventas (datos demo o pruebas). El inventario NO se modifica. Requiere contraseña de admin."
                                              style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;" wrapText="true" maxWidth="450.0" />
                                    </HBox>

                                    <Separator />

                                    <!-- Backup -->
                                    <Label text="Copia de Seguridad" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                                       <Button text="Generar Backup ahora" onAction="#generarBackup"
                                               style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold;" />
                                       <Button text="Restaurar Backup..." onAction="#restaurarBackup"
                                               style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;" />
                                    </HBox>
                                    <Label text="Guarda una copia del archivo .db en un pendrive o nube. Se recomienda hacer backup semanal." textFill="GRAY" />

                                 </children>
                              </VBox>
                           </children>
                        </AnchorPane></content>
                        </ScrollPane>
                     </content>
                  </Tab>

                  <!-- ===== SINCRONIZACIÓN CON SUPABASE (solo ADMIN) ===== -->
                  <Tab fx:id="tabSyncSupabase" text="Sincronización">
                     <content>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                        <content><AnchorPane minHeight="420.0">
                           <children>
                              <VBox fx:id="vboxSyncSupabase" spacing="14.0" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="15.0" AnchorPane.rightAnchor="20.0">
                                 <children>

                                    <Label text="Sincronización con Supabase" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                                    <Label text="Publica el catálogo de productos (stock, precio, categoría) hacia la tienda online. Requiere una cuenta de sincronización provista por el administrador del proyecto Supabase."
                                           style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;" wrapText="true" maxWidth="700.0" />

                                    <GridPane hgap="15.0" vgap="12.0">
                                       <columnConstraints>
                                          <ColumnConstraints minWidth="180.0" prefWidth="180.0" />
                                          <ColumnConstraints hgrow="ALWAYS" prefWidth="380.0" />
                                       </columnConstraints>
                                       <rowConstraints>
                                          <RowConstraints prefHeight="32.0" />
                                          <RowConstraints prefHeight="32.0" />
                                          <RowConstraints prefHeight="32.0" />
                                          <RowConstraints prefHeight="32.0" />
                                          <RowConstraints prefHeight="32.0" />
                                       </rowConstraints>
                                       <children>
                                          <Label text="URL del proyecto Supabase:" />
                                          <TextField fx:id="txtSupabaseUrl" GridPane.columnIndex="1" promptText="https://xxxx.supabase.co" />
                                          <Label text="Anon key:" GridPane.rowIndex="1" />
                                          <TextField fx:id="txtSupabaseAnonKey" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                          <Label text="Email de la cuenta de sync:" GridPane.rowIndex="2" />
                                          <TextField fx:id="txtSupabaseSyncEmail" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                          <Label text="Contraseña de la cuenta de sync:" GridPane.rowIndex="3" />
                                          <PasswordField fx:id="txtSupabaseSyncPassword" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                          <Label text="Intervalo de sincronización (min):" GridPane.rowIndex="4" />
                                          <TextField fx:id="txtSupabaseSyncIntervaloMin" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="80.0" />
                                       </children>
                                    </GridPane>

                                    <CheckBox fx:id="chkSupabaseSyncHabilitado" text="Habilitar sincronización automática (productos y ventas)" />

                                    <Label fx:id="lblSyncBloqueado" text="" wrapText="true" maxWidth="700.0"
                                           style="-fx-text-fill: #c0392b; -fx-font-size: 11;" visible="false" managed="false" />

                                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                                       <Button fx:id="btnSincronizarAhora" text="Sincronizar ahora" onAction="#sincronizarAhora"
                                               style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;" />
                                    </HBox>

                                 </children>
                              </VBox>
                           </children>
                        </AnchorPane></content>
                        </ScrollPane>
                     </content>
                  </Tab>

               </tabs>
            </TabPane>

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <Button onAction="#cerrarVentana" text="Cancelar" />
               <Button onAction="#guardarCambios" text="GUARDAR TODO"
                       style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;" />
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>
