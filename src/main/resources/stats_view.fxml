<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fedeiatech.sistemagestionpyme.view.StatsController">
    <children>
        <VBox spacing="10.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0"
              AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <children>
                <Label text="Estadísticas Avanzadas" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #2c3e50;" />
                <Label fx:id="lblPremiumLock" text="🔒 Esta sección requiere activación Premium."
                       style="-fx-font-size: 14; -fx-text-fill: #e74c3c; -fx-font-weight: bold;"
                       visible="false" managed="false" />

                <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS">
                    <tabs>

                        <Tab text="Canasta de productos" closable="false">
                            <content>
                                <VBox spacing="8.0" style="-fx-padding: 10;">
                                    <Label text="Pares de productos que aparecen juntos en el mismo ticket con frecuencia. Útil para armar combos, promociones o ubicar productos cercanos en el local."
                                           style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;" wrapText="true" />
                                    <TableView fx:id="tablaBasket" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colProdA" text="Producto A" prefWidth="230.0" />
                                            <TableColumn fx:id="colProdB" text="Producto B" prefWidth="230.0" />
                                            <TableColumn fx:id="colFrecuencia" text="Co-ocurrencias" prefWidth="120.0" />
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                    </TableView>
                                </VBox>
                            </content>
                        </Tab>

                        <Tab text="Mejor horario" closable="false">
                            <content>
                                <VBox spacing="8.0" style="-fx-padding: 10;">
                                    <Label text="Suma de ingresos por franja horaria en toda la historia de ventas. Útil para saber cuándo abrir o reforzar atención."
                                           style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;" wrapText="true" />
                                    <Label fx:id="lblMejorHorario" text="Calculando..."
                                           style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #27ae60;" />
                                    <BarChart fx:id="chartHoras" VBox.vgrow="ALWAYS" animated="false" legendVisible="false">
                                        <xAxis><CategoryAxis label="Hora del día" /></xAxis>
                                        <yAxis><NumberAxis label="Ingresos totales históricos ($)" /></yAxis>
                                    </BarChart>
                                </VBox>
                            </content>
                        </Tab>

                        <Tab text="Mapa de demanda" closable="false">
                            <content>
                                <ScrollPane fitToWidth="true" style="-fx-padding: 10;">
                                    <content>
                                        <VBox spacing="6.0" style="-fx-padding: 10;">
                                            <Label text="Cantidad de ventas según día de la semana y hora. Más oscuro = más tickets en esa franja. Útil para detectar picos y valles de demanda."
                                                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;" wrapText="true" />
                                            <GridPane fx:id="gridHeatmap" hgap="3.0" vgap="3.0" />
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </content>
                        </Tab>

                        <Tab text="Tendencias" closable="false">
                            <content>
                                <ScrollPane fitToWidth="true">
                                    <content>
                                        <VBox spacing="14.0" style="-fx-padding: 10;">
                                            <Label text="Evolución de ventas por semana y por mes. Permite identificar tendencias de crecimiento o caída en el tiempo."
                                                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;" wrapText="true" />

                                            <Label text="Ventas por semana (últimas 16 semanas)"
                                                   style="-fx-font-weight: bold; -fx-font-size: 13;" />
                                            <Label fx:id="lblResumenSemanal" text=""
                                                   style="-fx-font-size: 11; -fx-text-fill: #27ae60;" />
                                            <BarChart fx:id="chartSemanal" prefHeight="200.0" animated="false" legendVisible="false">
                                                <xAxis><CategoryAxis label="Semana" /></xAxis>
                                                <yAxis><NumberAxis label="Total ($)" /></yAxis>
                                            </BarChart>

                                            <Label text="Ventas por mes (último año)"
                                                   style="-fx-font-weight: bold; -fx-font-size: 13;" />
                                            <Label fx:id="lblResumenMensual" text=""
                                                   style="-fx-font-size: 11; -fx-text-fill: #2980b9;" />
                                            <BarChart fx:id="chartMensual" prefHeight="200.0" animated="false" legendVisible="false">
                                                <xAxis><CategoryAxis label="Mes" /></xAxis>
                                                <yAxis><NumberAxis label="Total ($)" /></yAxis>
                                            </BarChart>

                                            <Label text="Tabla semanal detallada"
                                                   style="-fx-font-weight: bold; -fx-font-size: 13;" />
                                            <TableView fx:id="tablaSemanal" prefHeight="200.0">
                                                <columns>
                                                    <TableColumn fx:id="colSemana" text="Semana" prefWidth="120.0" />
                                                    <TableColumn fx:id="colCantSemanal" text="Ventas" prefWidth="70.0" />
                                                    <TableColumn fx:id="colTotalSemanal" text="Total ($)" prefWidth="130.0" />
                                                    <TableColumn fx:id="colPromedioSemanal" text="Ticket promedio ($)" prefWidth="150.0" />
                                                </columns>
                                                <columnResizePolicy>
                                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                </columnResizePolicy>
                                            </TableView>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </content>
                        </Tab>

                    </tabs>
                </TabPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
