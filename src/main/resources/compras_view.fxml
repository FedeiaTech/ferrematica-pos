<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" prefHeight="620.0" prefWidth="640.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fedeiatech.sistemagestionpyme.view.ComprasController">
    <children>
        <VBox fx:id="formVBox" spacing="12.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>

                <Label text="Registrar Compra de Mercadería" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #2c3e50;" />

                <HBox spacing="8.0">
                    <children>
                        <TextField fx:id="txtBuscarProducto" promptText="Buscar producto por código o nombre..."
                                   HBox.hgrow="ALWAYS" onAction="#buscarProducto" />
                        <Button text="Buscar" onAction="#buscarProducto"
                                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-cursor: hand;" />
                    </children>
                </HBox>

                <Label fx:id="lblProductoElegido" text="Ningún producto seleccionado"
                       style="-fx-font-size: 12; -fx-text-fill: #7f8c8d;" wrapText="true" />

                <HBox spacing="10.0">
                    <children>
                        <VBox spacing="4.0">
                            <Label text="Cantidad" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" />
                            <TextField fx:id="txtCantidad" promptText="0" prefWidth="110.0" />
                        </VBox>
                        <VBox spacing="4.0">
                            <Label text="Costo Unitario ($)" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" />
                            <TextField fx:id="txtCostoUnitario" promptText="0.00" prefWidth="130.0" />
                        </VBox>
                        <VBox spacing="4.0">
                            <Label text="Costo Total" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" />
                            <Label fx:id="lblCostoTotal" text="ARS 0.00" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #2c3e50;" />
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="10.0">
                    <children>
                        <VBox spacing="4.0">
                            <Label text="Fecha" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" />
                            <DatePicker fx:id="dpFecha" prefWidth="150.0" />
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label text="Proveedor (opcional)" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" />
                            <TextField fx:id="txtProveedor" promptText="Nombre del proveedor" />
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="10.0" alignment="CENTER_RIGHT">
                    <children>
                        <Button text="CANCELAR" onAction="#cancelar"
                                style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                        <Button fx:id="btnGuardar" text="GUARDAR" onAction="#guardar"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                    </children>
                </HBox>

                <Label text="Últimas compras registradas" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #2c3e50;" />

                <TableView fx:id="tablaCompras" VBox.vgrow="ALWAYS" prefHeight="200.0">
                    <columns>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="90.0" />
                        <TableColumn fx:id="colProducto" text="Producto" prefWidth="180.0" />
                        <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80.0" />
                        <TableColumn fx:id="colCostoUnitario" text="Costo Unit." prefWidth="90.0" />
                        <TableColumn fx:id="colCostoTotal" text="Total" prefWidth="90.0" />
                        <TableColumn fx:id="colProveedor" text="Proveedor" prefWidth="110.0" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </children>
        </VBox>
    </children>
</AnchorPane>
